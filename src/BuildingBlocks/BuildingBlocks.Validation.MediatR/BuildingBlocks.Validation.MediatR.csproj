<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>BuildingBlocks.Validation.MediatR</RootNamespace>
    <Description>MediatR validation pipeline: runs every FluentValidation validator before the handler and maps the failure to a ProblemDetails field-error map.</Description>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="FluentValidation" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" />
    <PackageReference Include="MediatR" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BuildingBlocks.ProblemDetails\BuildingBlocks.ProblemDetails.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="BuildingBlocks.Validation.MediatR.Tests" />
  </ItemGroup>

</Project>
