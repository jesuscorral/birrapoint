# BirraPoint PWA + same-origin reverse proxy (ADR-0017).
# Rendered by the nginx image's envsubst step at container start (/etc/nginx/templates →
# /etc/nginx/conf.d). Only defined environment variables are substituted, so nginx's own
# $variables below are untouched. Required: API_UPSTREAM — the backend Container App's internal
# URL in ACA (https://<name>.internal.<env domain>; SNI enabled below), or http://api:8080 in a
# local docker network.

# Keep the scheme the client actually used (ACA ingress terminates TLS and sets it); fall back
# to this hop's scheme for direct local runs.
map $http_x_forwarded_proto $forwarded_proto {
    default $http_x_forwarded_proto;
    ''      $scheme;
}

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# Access log WITHOUT the query string: SignalR sends the bearer token as ?access_token= on
# WebSocket/SSE requests, and stdout ships to Log Analytics (Principle VII — never log tokens).
log_format birrapoint_noquery '$remote_addr - [$time_local] "$request_method $uri $server_protocol" '
                              '$status $body_bytes_sent "$http_user_agent" $request_time';

server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    server_tokens off;
    access_log /dev/stdout birrapoint_noquery;

    # Resolve API_UPSTREAM per request (valid=30s) instead of once at startup, so the web
    # container starts even while the API app is still being provisioned or restarted.
    resolver ${NGINX_LOCAL_RESOLVERS} valid=30s ipv6=off;
    set $api_upstream ${API_UPSTREAM};

    # Security headers. Locations below set caching with `expires` only — never add_header —
    # because any add_header inside a location would drop these inherited ones.
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    # SAMEORIGIN, not DENY: keycloak-js loads the app's own silent-check-sso page in an iframe.
    add_header X-Frame-Options "SAMEORIGIN" always;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    # Runtime configuration, generated by /docker-entrypoint.d/40-runtime-config.sh.
    location = /config.json {
        alias /tmp/birrapoint/config.json;
        default_type application/json;
        expires -1;
    }

    # Service-worker control files and the shell must always be revalidated, or clients keep
    # running a stale build after a deploy.
    location = /index.html       { expires -1; }
    location = /ngsw.json        { expires -1; }
    location = /ngsw-worker.js   { expires -1; }
    location = /safety-worker.js { expires -1; }
    location = /manifest.webmanifest { expires -1; }

    # REST API → backend (internal ingress only; never exposed publicly).
    location ^~ /api/ {
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_ssl_server_name on;
        # Host stays the upstream's own name (ACA routes internal traffic by Host); the public
        # host/scheme travel in X-Forwarded-* for the API's UseForwardedHeaders.
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Real-IP $remote_addr;
        # Entry/judge .xlsx imports.
        client_max_body_size 20m;
        proxy_read_timeout 120s;
    }

    # SignalR hub → backend, with WebSocket upgrade.
    location ^~ /hubs/ {
        # nginx's error log prints the full request line (query string included) on upstream
        # failures; for hub traffic that would leak ?access_token=. Upstream errors here are
        # visible in the API's own logs instead.
        error_log /dev/stderr crit;
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_ssl_server_name on;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
        proxy_buffering off;
    }

    # Content-hashed build output: cache for a year.
    location ~* \.(?:js|css|woff2?|ttf|png|jpe?g|svg|ico|webp)$ {
        expires 1y;
        try_files $uri =404;
    }

    # SPA fallback for client-side routes.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
