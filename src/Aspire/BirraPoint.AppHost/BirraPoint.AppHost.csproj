    <OutputType>Exe</OutputType>
    <TargetFramework>$(BirraPointTargetFramework)</TargetFramework>
    <UserSecretsId>a2ebe169-3993-4c3f-a649-cd18842901bf</UserSecretsId>
    <!-- DCP and dashboard come from the SDK NuGet packages, not the Aspire CLI bundle. -->
    <NoWarn>$(NoWarn);ASPIRE010</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.JavaScript" />
    <PackageReference Include="Aspire.Hosting.PostgreSQL" />
    <PackageReference Include="CommunityToolkit.Aspire.Hosting.MailPit" />
    <PackageReference Include="MessagePack" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\BirraPoint.Api\BirraPoint.Api.csproj" />
  </ItemGroup>
</Project>
