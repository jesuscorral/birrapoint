{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "allow": [
      "Bash(dotnet build:*)",
      "Bash(dotnet test:*)",
      "Bash(dotnet run:*)",
      "Bash(dotnet format:*)",
      "Bash(dotnet ef migrations:*)",
      "Bash(dotnet list:*)",
      "Bash(npm run:*)",
      "Bash(npm test:*)",
      "Bash(npm ci:*)",
      "Bash(npx jest:*)",
      "Bash(npx ng:*)",
      "Bash(npx playwright:*)",
      "Bash(npx prettier:*)",
      "Bash(npx eslint:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git fetch:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(git branch:*)",
      "Bash(git stash:*)",
      "Bash(git rev-parse:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr list:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(codegraph:*)",
      "Bash(terraform -chdir=infra/azure/terraform fmt:*)",
      "Bash(terraform -chdir=infra/azure/terraform validate:*)",
      "Bash(terraform -chdir=infra/azure/terraform test:*)",
      "Bash(terraform -chdir=infra/aws/terraform fmt:*)",
      "Bash(terraform -chdir=infra/aws/terraform validate:*)",
      "Bash(terraform -chdir=infra/aws/terraform test:*)",
      "Bash(node .claude/hooks/guard.test.js)",
      "Bash(bash .github/scripts/version.test.sh)",
      "Bash(bash .github/scripts/wait-revisions.test.sh)",
      "Bash(bash .github/scripts/ecs-health.test.sh)",
      "Bash(bash .github/scripts/require-dockerhub-read.test.sh)",
      "Bash(bash infra/keycloak/dapr-secrets/DaprSecretsEnv.test.sh)",
      "Bash(bash infra/keycloak/dapr-secrets/ApiAdminSecretGuard.test.sh)",
      "Bash(bash infra/keycloak/RealmProd.test.sh)",
      "Bash(docker info:*)",
      "Bash(docker ps:*)",
      "Bash(docker build:*)",
      "mcp__codegraph__codegraph_explore",
      "mcp__microsoft-learn",
      "mcp__terraform",
      "mcp__claude_ai_Context7",
      "mcp__postgres-local__list_schemas",
      "mcp__postgres-local__list_objects",
      "mcp__postgres-local__get_object_details",
      "mcp__postgres-local__explain_query"
    ],
    "ask": [
      "Bash(git restore:*)",
      "Bash(git checkout -- :*)",
      "Bash(git checkout .:*)",
      "Bash(git branch -D:*)",
      "Bash(git branch --delete:*)",
      "Bash(rm -rf:*)",
      "Bash(rm -r:*)",
      "Bash(gh pr close:*)",
      "Bash(gh api -X DELETE:*)",
      "Bash(gh api --method DELETE:*)",
      "Bash(docker compose down:*)",
      "Bash(docker rm:*)",
      "Bash(terraform -chdir=infra/azure/terraform state:*)",
      "Bash(terraform -chdir=infra/aws/terraform state:*)",
      "Bash(terraform -chdir=infra/azure/terraform import:*)",
      "Bash(terraform -chdir=infra/aws/terraform import:*)",
      "Bash(terraform -chdir=infra/azure/terraform force-unlock:*)",
      "Bash(terraform -chdir=infra/aws/terraform force-unlock:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(dotnet ef database drop:*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/appsettings.Production.json)",
      "Read(**/secrets.json)",
      "Read(**/terraform.tfvars)",
      "Read(**/*.tfstate)",
      "Read(**/*.tfstate.backup)",
      "Read(**/*.pfx)",
      "Read(**/*.key)",
      "Read(~/.aws/**)",
      "Read(~/.azure/**)"
    ]
  },
  "enabledMcpjsonServers": ["microsoft-learn", "terraform", "postgres-local"],
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.js\"", "timeout": 20 }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.js\"", "timeout": 10 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/post-edit.js\"", "timeout": 30 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/stop-check.js\"", "timeout": 180 }
        ]
      }
    ]
  }
}
