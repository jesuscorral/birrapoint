{
  "realm": "birrapoint",
  "enabled": true,
  "displayName": "BirraPoint",
  "registrationAllowed": true,
  "resetPasswordAllowed": true,
  "loginWithEmailAllowed": true,
  "registrationEmailAsUsername": true,
  "duplicateEmailsAllowed": false,
  "sslRequired": "external",
  "loginTheme": "birrapoint",
  "smtpServer": {
    "host": "${SMTP_HOST:localhost}",
    "port": "${SMTP_PORT:1025}",
    "from": "${SMTP_FROM:no-reply@birrapoint.local}",
    "fromDisplayName": "BirraPoint",
    "auth": "${SMTP_AUTH:false}",
    "starttls": "${SMTP_STARTTLS:false}",
    "user": "${SMTP_USER:}",
    "password": "${SMTP_PASSWORD:}"
  },
  "internationalizationEnabled": true,
  "supportedLocales": ["es", "en"],
  "defaultLocale": "es",
  "roles": {
    "realm": [
      { "name": "ORGANIZER", "description": "Competition organizer" },
      { "name": "JUDGE", "description": "Tasting judge" },
      {
        "name": "default-roles-birrapoint",
        "description": "Default roles granted to every new user in this realm — includes ORGANIZER so self-registration (registrationAllowed above) always produces an organizer account, matching the product decision that this registration form is organizer-only (judges are invited by an organizer instead, never self-register).",
        "composite": true,
        "clientRole": false,
        "composites": {
          "realm": ["ORGANIZER", "offline_access"]
        }
      }
    ]
  },
  "defaultRole": {
    "name": "default-roles-birrapoint",
    "description": "Default roles for realm birrapoint",
    "composite": true,
    "clientRole": false
  },
  "clients": [
    {
      "clientId": "birrapoint-spa",
      "name": "BirraPoint PWA (public, Authorization Code + PKCE)",
      "protocol": "openid-connect",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "rootUrl": "${SPA_URL:http://localhost:4200}",
      "baseUrl": "${SPA_URL:http://localhost:4200}",
      "redirectUris": ["${SPA_URL:http://localhost:4200}/*"],
      "webOrigins": ["${SPA_URL:http://localhost:4200}"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "${SPA_URL:http://localhost:4200}/*"
      },
      "fullScopeAllowed": true,
      "protocolMappers": [
        {
          "name": "birrapoint-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "birrapoint-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "birrapoint-api-admin",
      "name": "BirraPoint API service account for judge provisioning (secret comes from API_ADMIN_CLIENT_SECRET; the fallback is a LOCAL-DEV placeholder, production injects the real one at deploy time, FR-046)",
      "protocol": "openid-connect",
      "enabled": true,
      "publicClient": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "secret": "${API_ADMIN_CLIENT_SECRET:dev-only-secret-change-me}"
    }
  ],
  "users": [
    {
      "username": "organizer",
      "email": "organizer@birrapoint.local",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Seed",
      "lastName": "Organizer",
      "credentials": [
        { "type": "password", "value": "organizer", "temporary": false }
      ],
      "realmRoles": ["ORGANIZER"]
    },
    {
      "username": "service-account-birrapoint-api-admin",
      "enabled": true,
      "serviceAccountClientId": "birrapoint-api-admin",
      "clientRoles": {
        "realm-management": ["manage-users", "view-users"]
      }
    }
  ]
}
