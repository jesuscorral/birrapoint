# Copy to terraform.tfvars (gitignored) and fill in. subscription_id, location, api_image,
# web_image and keycloak_image are passed by infra/deploy.ps1 and do not belong here.
# NEON_API_KEY is read from the environment by the Neon provider — never put it in this file.

# The environment (resource names birrapoint-<environment>-<acronym>) is NOT set here: it comes
# from deploy.ps1 / teardown.ps1 -Environment (default PROD), which also picks the state location.

# key_vault_name = "birrapoint-prod-kv-x7"    # only if birrapoint-<env>-kv is taken (globally unique)
# key_vault_secrets_officer_principal_ids = ["<entra-group-object-id>"]   # every operator identity

# Private Docker Hub repositories only — leave both empty for public ones.
# dockerhub_username = "myhubuser"
# dockerhub_token    = "dckr_pat_..."   # read-only access token

# neon_region                    = "aws-eu-central-1"
# neon_org_id                    = "org-..."   # only if the API key belongs to several orgs
# neon_history_retention_seconds = 21600       # free plan maximum (6 h)

smtp_host         = "smtp.example.com"
smtp_port         = 587
smtp_username     = "apikey"
smtp_password     = "change-me"
smtp_use_starttls = true
smtp_from_address = "no-reply@example.com"

# web_min_replicas = 1
