# Copy to terraform.tfvars (gitignored) and fill in. Nothing account-specific or secret is
# committed; where each value comes from:
#   - state:        HCP Terraform, workspace in Local execution mode - TF_CLOUD_ORGANIZATION and
#                   TF_WORKSPACE environment variables, `terraform login` or TF_TOKEN_app_terraform_io
#   - subscription: ARM_SUBSCRIPTION_ID environment variable (or the `az login` default)
#   - Neon:         NEON_API_KEY environment variable - never put it in this file
#   - images:       image_namespace below, versions on the command line (-var release_version=1.2.3)

# Docker Hub user/org that owns the birrapoint-* repositories (required).
image_namespace = "myhubuser"

# "latest" (CI images, birrapoint-<c>:latest) or a release X.Y.Z (birrapoint-<c>-release:X.Y.Z).
# release_version = "latest"
# api_version      = "1.2.3"   # per-component overrides; default to release_version
# web_version      = "1.2.3"
# keycloak_version = "1.2.3"

# Resource names are birrapoint-<environment>-<acronym>; the deploy workflow passes
# BIRRAPOINT_ENVIRONMENT as TF_VAR_environment.
# environment = "PROD"

# key_vault_name = "birrapoint-prod-kv-x7"    # only if birrapoint-<env>-kv is taken (globally unique)
# key_vault_secrets_officer_principal_ids = ["<entra-group-object-id>"]   # every operator identity

# Private Docker Hub repositories only - leave both empty for public ones.
# dockerhub_username = "myhubuser"
# dockerhub_token    = "dckr_pat_..."   # read-only access token

# neon_region                    = "aws-eu-central-1"
# neon_org_id                    = "org-..."   # only if the API key belongs to several orgs
# neon_history_retention_seconds = 21600       # free plan maximum (6 h)

smtp_host         = "smtp.example.com"
smtp_port         = 587
smtp_username     = "apikey"
smtp_password     = "change-me"
smtp_use_starttls = true
smtp_from_address = "no-reply@example.com"

# web_min_replicas = 1
