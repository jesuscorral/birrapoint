{
  "mcpServers": {
    "microsoft-learn": {
      "type": "http",
      "url": "https://learn.microsoft.com/api/mcp"
    },
    "terraform": {
      "type": "stdio",
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "hashicorp/terraform-mcp-server"
      ],
      "env": {}
    },
    "postgres-local": {
      "type": "stdio",
      "command": "node",
      "args": [".claude/mcp/postgres-local.js"],
      "env": {}
    }
  }
}
